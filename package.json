{
  "name": "indiandecorcompany",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.js && npm run validate:schema && npm run validate:links",
    "validate:schema": "node scripts/validate-jsonld.js",
    "validate:links": "node scripts/validate-internal-links.js",
    "predeploy": "npm run validate:schema && npm run validate:links",
    "deploy": "npm run build && wrangler pages deploy dist --project-name indiandecorcompany",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wrangler": "^4.151.0"
  }
}
